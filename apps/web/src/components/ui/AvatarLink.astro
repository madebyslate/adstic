---
import type { AvatarLink } from '@repo/shared'
import Picture from '@/components/ui/Picture.astro'

interface Props {
  link: AvatarLink
  class?: string
  /**
   * Przepuszczane wprost na `<a>`. Astro nie rozlewa nieznanych propów na
   * element główny, a wywołujący musi mieć jak podać `--reveal-index`, czyli
   * swoje miejsce w choreografii wejścia sekcji.
   */
  style?: string
}

const { link, class: className, style } = Astro.props
---

{
  /*
    Pigułka z twarzą założyciela. Ten sam przycisk stoi w `WhoWeAre`
    i w `CaseStudies` — stąd komponent, a nie dwa razy te same 40 linii CSS.
    Awatar jest CZĘŚCIĄ przycisku: bez zdjęcia nie ma wariantu tej kontrolki.
  */
}
<a
  class:list={['avatar-link', 'btn-wipe', className]}
  style={style}
  href={link.href}
  aria-label={link.ariaLabel}
  rel={link.external ? 'noopener noreferrer' : undefined}
  target={link.external ? '_blank' : undefined}
>
  <span class="avatar-link__avatar">
    <Picture image={link.avatar} widths={[32, 64]} sizes="32px" />
  </span>
  {link.label}
</a>

<style>
  .avatar-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-5) var(--space-1) var(--space-1);
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-normal);
    text-decoration: none;
  }

  /*
    Kółko robi opakowanie, nie sam <img>: klasa przekazana do komponentu trafia
    w jego zakres stylów, więc scoped selektor rodzica by jej nie dosięgnął.
  */
  .avatar-link__avatar {
    display: block;
    flex: none;
    width: 32px;
    height: 32px;
    overflow: hidden;
    border-radius: var(--radius-full);
  }

  .avatar-link__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
