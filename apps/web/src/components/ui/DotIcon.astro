---
import type { MediaImage } from '@repo/shared'
import { readDotIcon } from '@/lib/dot-icon'

interface Props {
  /** Ten sam `MediaImage` co w `<img src>` — ikona zostaje polem danych. */
  icon: MediaImage
  class?: string
}

const { icon, class: className } = Astro.props
const { viewBox, blurRatio, grid, shape } = readDotIcon(icon)

/** Bez zer na końcu — każdy zbędny znak mnoży się przez liczbę kropek. */
const round = (value: number, places = 2) => Number(value.toFixed(places)).toString()
---

{/*
  Ikona kropkowa wypisana INLINE, a nie przez `<img src>`.

  Powód jest jeden: kropki kształtu mają oddychać, a do zawartości pliku
  wstawionego przez `<img>` CSS nie ma dostępu — to dla przeglądarki jeden
  nieprzezroczysty obrazek.

  Trzy grupy odpowiadają trzem warstwom z eksportu Figmy (opisane w
  `lib/dot-icon.ts`) i są malowane w tej samej kolejności co tam:

    1. poświata — rozmyta czerwona kopia kształtu, POD siatką,
    2. siatka   — kropki tła, ostre,
    3. kształt  — te same pozycje co poświata, ostro, w kolorze treści.

  Poświata i kształt niosą TĘ SAMĄ fazę i tempo, bo to jeden błysk tej samej
  kropki widziany w dwóch warstwach.

  Kolejność nie jest dowolna: siatka ma leżeć NA poświacie, więc czerwień
  prześwituje między jej kropkami, a nie po nich rozlewa.

  Ten komponent NIE MA własnego `<style>` i to jest decyzja, nie przeoczenie:
  Astro dokleiłby klasę zasięgu do każdego z 338 kółek. Mechanika siedzi
  w `global.css` przy „Ikony kropkowe”.
*/}
<svg
  class:list={['dot-icon', className]}
  viewBox={viewBox}
  style={`--dot-icon-blur-ratio:${round(blurRatio, 5)}`}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <g class="dot-icon__glow">
    {
      shape.map((dot) => (
        <circle
          cx={round(dot.cx)}
          cy={round(dot.cy)}
          r={round(dot.r)}
          style={`--dot-phase:${round(dot.phase, 3)};--dot-rate:${round(dot.rate ?? 1, 3)}`}
        />
      ))
    }
  </g>

  <g class="dot-icon__grid">
    {
      grid.map((dot) => (
        <circle
          cx={round(dot.cx)}
          cy={round(dot.cy)}
          r={round(dot.r)}
          style={`--dot-phase:${round(dot.phase, 3)}`}
        />
      ))
    }
  </g>

  <g class="dot-icon__face">
    {
      shape.map((dot) => (
        <circle
          cx={round(dot.cx)}
          cy={round(dot.cy)}
          r={round(dot.r)}
          style={`--dot-phase:${round(dot.phase, 3)};--dot-rate:${round(dot.rate ?? 1, 3)}`}
        />
      ))
    }
  </g>
</svg>
