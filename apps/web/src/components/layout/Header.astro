---
import Logo from '@/assets/adstic-logo.svg?raw'
import { mainNavigation, headerCta } from '@/lib/navigation'

/**
 * Nagłówek strony.
 *
 * Logo jest wklejone inline (`?raw`), a nie przez `<img>`: to 8 KB, więc jeden
 * request mniej jest wart tych bajtów, a sygnet dziedziczy `currentColor`
 * z tokenu tekstu zamiast nieść własną biel (AGENT-RULES §4).
 *
 * Układ to siatka 1fr–auto–1fr, nie flex ze `space-between`: nawigacja ma być
 * wyśrodkowana względem STRONY, a nie względem wolnego miejsca między logiem
 * a przyciskiem — inaczej przesuwałaby się przy każdej zmianie długości etykiet.
 */
---

<header class="header">
  <div class="container-page header__inner">
    <a class="header__brand reveal" href="/" aria-label="Adstic — strona główna" style="--reveal-index: 0">
      <Fragment set:html={Logo} />
    </a>

    <nav class="header__nav" aria-label="Nawigacja główna">
      <ul class="header__list">
        {
          mainNavigation.map((item, index) => (
            <li class="reveal" style={`--reveal-index: ${index + 1}`}>
              <a class="header__link" href={item.href} aria-label={item.ariaLabel}>
                {/*
                  Etykieta jest w środku DWA razy. Hover przewija maskę o pół
                  jej wysokości, więc pierwsza kopia wyjeżdża górą, a druga
                  wjeżdża dołem — ruch jest całym sygnałem, bez podkreślenia
                  i bez zmiany koloru. Duplikat niesie zero treści, stąd
                  `aria-hidden`: czytnik ekranu ma usłyszeć pozycję menu raz.
                */}
                <span class="header__roll">
                  <span class="header__label">{item.label}</span>
                  <span class="header__label" aria-hidden="true">
                    {item.label}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions reveal" style={`--reveal-index: ${mainNavigation.length + 1}`}>
      <a class="header__cta btn-wipe" href={headerCta.href} aria-label={headerCta.ariaLabel}>
        {headerCta.label}
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    background-color: var(--color-header-bg);
    border-bottom: var(--header-border-width) solid var(--color-border-subtle);
    /*
      Krok wejścia krótszy niż globalne 90 ms i to celowo: pozycji w pasku jest
      kilka, a przy globalnym kroku ostatnia wchodziłaby wtedy, gdy nagłówek
      hero jest już na miejscu — pasek czytałby się jak osobna, spóźniona
      animacja zamiast jak jedna klatka otwarcia strony.
    */
    --reveal-step: 60ms;
  }

  .header__inner {
    display: grid;
    /* Bez nawigacji (poniżej 1024 px) kolumny są dwie — przy trzech logo i CTA
       rozjeżdżają się na środek, bo obie skrajne mają po `1fr`. */
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
    padding-block: var(--space-2);
  }

  .header__brand {
    display: inline-flex;
    color: var(--color-fg);
  }

  .header__brand :global(svg) {
    display: block;
    height: 1.9375rem; /* 31 px — wysokość własna sygnetu */
    width: auto;
  }

  /* Nawigacja i CTA chowają się na wąskich ekranach — patrz Hero.spec.md,
     menu mobilne powstaje razem z blokiem nawigacji, nie tutaj. */
  .header__nav {
    display: none;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
    Maska jest dokładnie jednym wierszem wysoka. Bez jawnej wysokości urosłaby
    do obu kopii i duplikat byłby po prostu widoczny pod etykietą.

    `line-height` wprost, nie z tokenu `--leading-normal`: przewinięcie przycina
    się na krawędzi maski, a przy ciasnym wiodącym ogonek „y" w „Wyceny"
    ścinałby się razem z nią.
  */
  .header__link {
    display: block;
    block-size: 1.4em;
    overflow: hidden;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--color-fg);
  }

  .header__roll {
    display: block;
    transition: transform var(--duration-slow) var(--ease-in-out-token);
  }

  .header__link:hover .header__roll,
  .header__link:focus-visible .header__roll {
    transform: translate3d(0, -50%, 0);
  }

  .header__label {
    display: block;
  }

  .header__actions {
    display: flex;
    justify-content: end;
  }

  .header__cta {
    /* `inline-block` jest wymogiem `.btn-wipe`, nie kosmetyką: na elemencie
       liniowym `overflow: clip` jest ignorowany, więc kłąb hoveru wychodziłby
       poza pigułkę zamiast zostać przycięty do jej obrysu. */
    display: inline-block;
    /* „Zaokrąglone max" z makiety — przy tej wysokości pigułka. */
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    color: var(--color-fg);
    padding: var(--control-padding-y) var(--control-padding-x);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .header__nav {
      display: block;
    }
  }
</style>
