---
import type { CaseStudiesBlock } from '@repo/shared'
import AvatarLink from '@/components/ui/AvatarLink.astro'
import Picture from '@/components/ui/Picture.astro'
import { resolveVector } from '@/lib/media'

interface Props {
  block: CaseStudiesBlock
}

const { block } = Astro.props
const headingId = 'case-studies-heading'

/*
 * Kafel zajmuje pół kolumny treści na desktopie, całą poniżej 768 px. Te same
 * dwie liczby idą do `sizes` i wynikają z siatki, nie z „na wszelki wypadek" —
 * za szeroki wariant to pobrany plik, którego nikt nie zobaczy.
 */
const TILE_SIZES = '(min-width: 768px) min(50vw, 590px), 100vw'
---

{/*
  Wejście sekcji. Grupa trzyma wszystkie animacje w środku na pierwszej klatce,
  dopóki obserwator w BaseLayout nie uzna, że warto ją odegrać — mechanizm jest
  opisany przy „W polu widzenia" w global.css.
*/}
<section class="cases" aria-labelledby={headingId} data-reveal-group>
  <div class="container-page cases__inner">
    <p class="cases__eyebrow reveal" style="--reveal-index: 0">{block.eyebrow}</p>

    {/* Etykieta wyżej jest podpisem, nagłówkiem sekcji jest to zdanie. */}
    <h2 id={headingId} class="cases__heading reveal" style="--reveal-index: 1">{block.heading}</h2>

    <div class="cases__intro">
      <p class="cases__lead reveal" style="--reveal-index: 2">{block.lead}</p>
      <AvatarLink link={block.cta} class="cases__cta reveal" style="--reveal-index: 3" />
    </div>

    {/*
      `<ul>`, nie `<div>`: to jest lista realizacji, a czytnik ekranu ma usłyszeć
      ile ich jest. Kafle i wiersze to DWIE listy, bo są dwiema formami
      wyróżnienia — jedna lista z dwoma wyglądami kłamałaby o strukturze.
    */}
    <ul class="cases__grid">
      {
        block.featured.map((item, index) => (
          <li class="reveal" style={`--reveal-index: ${index + 4}`}>
            <a
              class="tile"
              href={item.href}
              rel={item.external ? 'noopener noreferrer' : undefined}
              target={item.external ? '_blank' : undefined}
            >
              <span class="tile__media">
                <Picture image={item.thumbnail} widths={[590, 1180]} sizes={TILE_SIZES} />
              </span>

              {/*
                Wynik jest osobnym, animowanym SVG nad kadrem. Zdjęcia można
                dzięki temu podmienić na czyste wersje bez składania ich od
                nowa; pusty `alt`, bo tę samą informację niesie tytuł linku.
              */}
              <img
                class:list={[
                  'tile__result',
                  item.resultGraphic.width < 270 && 'tile__result--compact',
                ]}
                data-case-result
                data-src={resolveVector(item.resultGraphic)}
                alt=""
                width={item.resultGraphic.width}
                height={item.resultGraphic.height}
                loading="lazy"
                decoding="async"
                fetchpriority="auto"
                draggable="false"
              />
              <noscript>
                <img
                  class:list={[
                    'tile__result',
                    item.resultGraphic.width < 270 && 'tile__result--compact',
                  ]}
                  src={resolveVector(item.resultGraphic)}
                  alt=""
                  width={item.resultGraphic.width}
                  height={item.resultGraphic.height}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              </noscript>

              <span class="tile__logo">
                <Picture image={item.logo} widths={[item.logo.width]} sizes={`${item.logo.width}px`} />
              </span>

              {/*
                Strzałka wchodzi na hover i na focus klawiaturą — bez tego
                drugiego link byłby zaznaczony, ale bez afordancji „to wychodzi
                na zewnątrz". Poza drzewem dostępności: niesie ją już `<a>`.
              */}
              <span class="tile__arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5.83203 5.83325H14.1654V14.1666" />
                  <path d="M5.83203 14.1666L14.1654 5.83325" />
                </svg>
              </span>

              <span class="tile__title">{item.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      block.more.length > 0 && (
        <ul class="cases__list">
          {block.more.map((item, index) => (
            <li class="reveal" style={`--reveal-index: ${index + 5}`}>
              <a
                class="row"
                href={item.href}
                rel={item.external ? 'noopener noreferrer' : undefined}
                target={item.external ? '_blank' : undefined}
              >
                <span class="row__logo">
                  <Picture
                    image={item.logo}
                    widths={[64, 128]}
                    sizes="64px"
                  />
                </span>

                <span class="row__title">{item.title}</span>

                <span class="row__arrow" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5.83203 5.83325H14.1654V14.1666" />
                    <path d="M5.83203 14.1666L14.1654 5.83325" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<script>
  const resultGraphics = document.querySelectorAll<HTMLImageElement>('[data-case-result]')

  const loadResult = (image: HTMLImageElement) => {
    const source = image.dataset.src
    if (!source || image.hasAttribute('src')) return

    const rawDelay = getComputedStyle(image).getPropertyValue('--case-result-start-delay').trim()
    const parsedDelay = Number.parseFloat(rawDelay)
    const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 0
      : rawDelay.endsWith('ms')
        ? parsedDelay
        : parsedDelay * 1000

    window.setTimeout(() => {
      image.src = source
      delete image.dataset.src
    }, Number.isFinite(delay) ? delay : 0)
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          loadResult(entry.target as HTMLImageElement)
          observer.unobserve(entry.target)
        }
      },
      { threshold: 0.28, rootMargin: '0% 0% -8% 0%' },
    )

    resultGraphics.forEach((image) => observer.observe(image))
  } else {
    resultGraphics.forEach(loadResult)
  }
</script>

<style>
  /*
    Pion sekcji siedzi na `__inner`, nie na `<section>`: kreska ma być NAD
    odstępem, czyli przy samej krawędzi kolumny treści. Gdyby padding był
    na sekcji, border poszedłby na całą szerokość okna.
  */
  .cases__inner {
    border-block-start: 1px solid var(--color-border-rule);
    padding-block: var(--section-padding-y);
  }

  .cases__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .cases__eyebrow::before {
    content: '';
    width: var(--space-1);
    height: var(--space-1);
    background-color: var(--color-brand);
  }

  .cases__heading {
    margin: 0 0 var(--space-4);
    color: var(--color-fg);
    font-family: var(--font-heading);
    /* 48 px dotyczy desktopu — na 390 px zostawiałoby dwa słowa w wierszu. */
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  /*
    Zdanie i przycisk stoją w jednym wierszu, ale to NIE jest siatka: przycisk
    ma zostać przy prawej krawędzi niezależnie od tego, na ile wierszy złamie
    się zdanie. Stąd `space-between`, a nie kolumny.
  */
  .cases__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-block-end: var(--space-7);
  }

  .cases__lead {
    /* Ta sama szerokość co zdanie w HowWeWork — łamie się jak w złożeniu. */
    max-width: var(--steps-lead-width);
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-normal);
  }

  .cases__cta {
    flex: none;
  }

  /* ── Kafle ──────────────────────────────────────────────────────────────── */

  .cases__grid,
  .cases__list {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--grid-gap);
    list-style: none;
  }

  .cases__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-end: var(--grid-gap);
  }

  .tile {
    position: relative;
    display: block;
    /*
      `overflow: hidden` zamiast promienia na kadrze i na gradiencie osobno —
      klient podał `border-radius: 0 0 12px 12px` dla przeciemnienia właśnie po
      to, żeby nie wystawało poza kafel. Przycięcie w jednym miejscu robi to
      samo i nie rozjeżdża się, gdy promień kafla kiedyś się zmieni.
    */
    overflow: hidden;
    /* Piętra warstw kafla zostają wewnątrz kafla — nie licytują się z sekcją. */
    isolation: isolate;
    border-radius: var(--radius-media);
    aspect-ratio: var(--case-tile-ratio);
    color: var(--color-fg);
    text-decoration: none;
  }

  .tile__media {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
  }

  /* Sam kadr, nie logo ani grafika wyniku. */
  .tile__media :global(img) {
    position: relative;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
      Zbliżenie kadru pod kursorem. Rusza się ZDJĘCIE, nie kafel: kafel przycina
      (`overflow: hidden`), więc jego krawędzie, logo i tytuł stoją w miejscu,
      a rośnie tylko to, co pod nimi. Powiększenie kafla przesuwałoby sąsiadów
      w siatce — i tak nie zadziałałoby, bo `<li>` niesie animację wejścia
      wypełniającą `transform` (PLAYBOOK P-057).

      `scale` osobną własnością, nie w `transform` — nie kasuje niczego, co
      ktoś dopisze obok, i idzie tą samą szybką ścieżką kompozytora.
    */
    transition: scale var(--duration-slow) var(--ease-standard);
  }

  .tile:hover .tile__media :global(img),
  .tile:focus-visible .tile__media :global(img) {
    scale: var(--case-tile-zoom);
  }

  .tile__result {
    --case-result-start-delay: var(--case-result-delay);
    position: absolute;
    z-index: 1;
    inset-block-start: var(--case-result-offset-y);
    inset-inline-start: 50%;
    display: block;
    width: var(--case-result-width);
    height: auto;
    translate: -50% 0;
    pointer-events: none;
  }

  .tile__result--compact {
    width: var(--case-result-width-compact);
  }

  /*
    Przeciemnienie pod tytułem. Pseudoelement, nie osobny węzeł: to czysta
    warstwa malarska, więc nie ma po co trzymać jej w HTML-u.

    PUŁAPKA (PLAYBOOK P-063): kolejność malowania NIE może opierać się tu na
    kolejności w drzewie. Zdjęcie dostaje na hover `scale`, a każda wartość inna
    niż `none` tworzy kontekst układania — kadr zaczyna być malowany jak element
    pozycjonowany z `z-index: 0`, czyli NAD tym `::before` (pseudoelement jest
    wcześniej w drzewie). Efekt bez `z-index`: przeciemnienie znika w klatce
    wejścia w hover i wraca dopiero, gdy przejście `scale` dobiegnie końca
    i kontekst zniknie. Dlatego warstwy dostają jawne piętra: kadr 0,
    grafika wyniku 1, przeciemnienie 2, treść (logo, strzałka, tytuł) 3.
  */
  .tile::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset-inline: 0;
    inset-block-end: 0;
    /*
      210 px to wartość z desktopu, gdzie kafel ma 516 px wysokości — czyli
      41 % kadru. Na 390 px kafel ma 299 px i te same 210 px zjadłyby 70 %
      zdjęcia. `min()` trzyma OBIE reguły: stałą wysokość, dopóki mieści się
      w udziale z makiety, i ten udział poniżej.
    */
    height: min(var(--case-tile-scrim-height), var(--case-tile-scrim-ratio));
    /* Nie zasłania linku — kafel jest jednym `<a>`, ale to i tak tańsze niż
       zdejmowanie zdarzeń dopiero na poziomie tytułu. */
    pointer-events: none;
    background: var(--case-tile-scrim);
  }

  .tile__logo {
    position: absolute;
    z-index: 3;
    inset-block-start: var(--space-5);
    inset-inline-start: var(--space-5);
    display: block;
  }

  /*
    Loga klientów mają różne proporcje i idą w rozmiarze własnym — jedna
    narzucona wysokość zrobiłaby z kwadratowego Apimela znaczek, a z poziomego
    Tandemy pas przez pół kafla. Cap pilnuje tylko górnej granicy.
  */
  .tile__logo :global(img) {
    width: auto;
    height: auto;
    max-width: var(--case-tile-logo-max-width);
    max-height: var(--case-tile-logo-max-height);
    object-fit: contain;
  }

  .tile__arrow,
  .row__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--case-arrow-size);
    height: var(--case-arrow-size);
    border-radius: var(--radius-full);
    color: var(--color-fg);
  }

  .tile__arrow :global(svg),
  .row__arrow :global(svg) {
    width: var(--case-arrow-icon-size);
    height: var(--case-arrow-icon-size);
  }

  .tile__arrow {
    position: absolute;
    z-index: 3;
    inset-block-start: var(--space-5);
    inset-inline-end: var(--space-5);
    background-color: var(--case-arrow-bg-media);
    opacity: 0;
    /*
      Strzałka nie tylko się pojawia — dojeżdża po skosie z tej strony, w którą
      pokazuje (w prawo w górę), więc stan spoczynku jest jej przesunięciem
      startowym. Ruch jest krótszy niż zbliżenie kadru (`fast` vs `slow`):
      afordancja ma być natychmiast, kadr może dochodzić.
    */
    translate: calc(-1 * var(--case-arrow-nudge)) var(--case-arrow-nudge);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      translate var(--duration-fast) var(--ease-standard);
  }

  .tile:hover .tile__arrow,
  .tile:focus-visible .tile__arrow {
    opacity: 1;
    translate: 0 0;
  }

  .tile__title {
    /* Deklaracje wyglądu tytułu są niżej; tu tylko jego ruch pod kursorem. */
    transition: translate var(--duration-base) var(--ease-standard);
  }

  /* Tytuł unosi się o włos — tyle, żeby kafel „odetchnął", nie żeby skoczył. */
  .tile:hover .tile__title,
  .tile:focus-visible .tile__title {
    translate: 0 calc(-1 * var(--case-title-lift));
  }

  .tile__title {
    position: absolute;
    z-index: 3;
    inset-block-end: var(--space-5);
    inset-inline: var(--space-5);
    max-width: var(--case-title-width);
    /*
      Makieta mówi 600. Shipujemy wyłącznie 400 i 500 (patrz `--font-weight-bold`
      w tokenach), a 600 wywołałoby syntetyczne pogrubienie przeglądarki —
      zostaje 500 do czasu dostarczenia pliku fontu. CaseStudies.spec.md.
    */
    font-size: var(--case-title-size);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-normal);
  }

  /* ── Lista pozostałych ──────────────────────────────────────────────────── */

  .row {
    display: flex;
    align-items: center;
    gap: var(--case-row-gap);
    padding: var(--space-2);
    border-radius: var(--radius-media);
    background-color: var(--case-row-bg);
    color: var(--color-fg);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .row:hover {
    background-color: var(--case-row-bg-hover);
  }

  .row__logo {
    display: block;
    flex: none;
    width: var(--case-row-logo-size);
    height: var(--case-row-logo-size);
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .row__logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--duration-base) var(--ease-standard);
  }

  /* To samo zbliżenie co na kaflu — wiersz jest tą samą realizacją, mniejszą. */
  .row:hover .row__logo :global(img),
  .row:focus-visible .row__logo :global(img) {
    scale: var(--case-tile-zoom);
  }

  .row__title {
    flex: 1;
    font-size: var(--case-title-size);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-normal);
  }

  /*
    Strzałka wiersza stoi 16 px od krawędzi, a nie 8 px jak logo — padding
    wiersza dotyczy logo, bo to ono ustala jego wysokość. Różnicę dokłada
    margines, żeby `padding` pozostał jedną liczbą z makiety.
  */
  .row__arrow {
    margin-inline-end: var(--space-2);
    /*
      `backdrop-filter: blur()` z makiety jest tu no-opem: pod strzałką leży
      jednolita plama `--case-row-bg`, więc rozmycie nie ma czego rozmywać
      (PLAYBOOK P-015). Zostaje sam kolor.
    */
    background-color: var(--color-control-ghost);
    /* Ten sam skos co na kaflu — z tą różnicą, że w wierszu strzałka jest
       widoczna zawsze, więc rusza się dopiero pod kursorem. */
    transition: translate var(--duration-fast) var(--ease-standard);
  }

  .row:hover .row__arrow,
  .row:focus-visible .row__arrow {
    translate: var(--case-arrow-nudge) calc(-1 * var(--case-arrow-nudge));
  }

  /* ── Breakpointy ────────────────────────────────────────────────────────── */

  @media (max-width: 767px) {
    .cases__heading {
      font-size: var(--text-3xl);
    }

    .cases__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /*
      Na wąskim ekranie strzałka nie ma jak się „pojawić" — nie ma hovera.
      Stąd stan domyślny widoczny i na swoim miejscu, nie ukryty i odsunięty.
    */
    .tile__arrow {
      opacity: 1;
      translate: 0 0;
    }

    .row__title {
      font-size: var(--text-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /*
      Strzałka dalej WCHODZI na hover — znika tylko przejście. Ukrycie zmiany
      stanu zabrałoby afordancję, a to nie jest ruch, tylko informacja.
    */
    .tile__arrow,
    .row {
      transition-duration: 0.01ms;
    }

    /*
      Reguła globalna skraca przejścia do 0,01 ms, ale zbliżenie i dojazd
      zostałyby wtedy PRZESKOKIEM — a to nadal ruch. Strzałka pojawia się dalej
      (to informacja), tylko już bez drogi do przebycia.
    */
    .tile__arrow,
    .tile:hover .tile__arrow,
    .tile:focus-visible .tile__arrow,
    .row:hover .row__arrow,
    .row:focus-visible .row__arrow,
    .tile:hover .tile__title,
    .tile:focus-visible .tile__title {
      translate: 0 0;
    }

    .tile:hover .tile__media :global(img),
    .tile:focus-visible .tile__media :global(img),
    .row:hover .row__logo :global(img),
    .row:focus-visible .row__logo :global(img) {
      scale: 1;
    }
  }
</style>
