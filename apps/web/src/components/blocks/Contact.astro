  }

  .contact__stage {
    position: relative;
    width: 100%;
    max-width: var(--contact-panel-width);
    margin-inline: auto;
  }

  /*
    Obrys 24 px dookoła płyty. Osobny element, a nie `outline` płyty: łuk ma
    inny promień niż płyta (24 vs 16 px), więc musi mieć własne pudełko.
  */
  .contact__halo {
    position: absolute;
    inset: var(--contact-halo-inset);
    border: 1px solid var(--contact-halo-border);
    border-radius: var(--contact-halo-radius);
    pointer-events: none;
  }

  /*
    Czerwone światło pod krawędzią płyty. Rozmyty obrys, nie cień: `box-shadow`
