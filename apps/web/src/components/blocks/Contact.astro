---
import type { ContactBlock } from '@repo/shared'
import Picture from '@/components/ui/Picture.astro'

interface Props {
  block: ContactBlock
}

const { block } = Astro.props
const headingId = 'contact-heading'
const errorId = 'contact-goals-error'

/*
 * Kolejność kroków jest tu, a nie w danych: numer i ikona wynikają z POZYCJI
 * w pasie (ta sama zasada co `--placement-dot-*` w AdPlacements). Fixture nie
 * może więc opisać kroków 1, 1, 3.
 */
const steps = [block.goalsStep, block.detailsStep, block.summaryStep]

/*
 * Etap 1 nie ma endpointów (AGENT-RULES §1), więc `action` jest puste i wysyłka
 * zostaje wyłączona. Etap 2 wypełnia pole adresem kolekcji Payloada — i to
 * jedyna zmiana, jakiej ten blok wtedy wymaga.
 */
const canSubmit = Boolean(block.action)

/* Ikony kroków — jedna definicja, trzy referencje. */
const ICON_IDS = ['contact-icon-store', 'contact-icon-chart', 'contact-icon-calendar']
---

{/*
  Wejście sekcji. Grupa trzyma wszystkie animacje w środku na pierwszej klatce,
  dopóki obserwator w BaseLayout nie uzna, że warto ją odegrać — mechanizm jest
  opisany przy „W polu widzenia" w global.css.
*/}
<section class="contact" aria-labelledby={headingId} data-reveal-group>
  {/* Kadr z łuną pod całą sekcją. Dekoracja — poza drzewem dostępności. */}
  <div class="contact__backdrop reveal-fade" style="--reveal-index: 0" aria-hidden="true">
    <Picture image={block.background} widths={[768, 1440, 2880]} sizes="100vw" />
  </div>

  {/*
    Ikony kroków jako `<symbol>` + `<use>`: trzy rysunki, ale każdy stoi
    w dwóch stanach taba, więc definicja jest jedna, a nie kopiowany inline SVG.
  */}
  <svg class="contact__sprite" aria-hidden="true" focusable="false">
    <symbol id={ICON_IDS[0]} viewBox="0 0 24 24" fill="none">
      <path
        d="M15 21V16C15 15.7348 14.8946 15.4804 14.7071 15.2929C14.5196 15.1054 14.2652 15 14 15H10C9.73478 15 9.48043 15.1054 9.29289 15.2929C9.10536 15.4804 9 15.7348 9 16V21"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M17.7749 10.31C17.5665 10.1104 17.289 9.99904 17.0004 9.99904C16.7118 9.99904 16.4344 10.1104 16.2259 10.31C15.7609 10.7535 15.143 11.001 14.5004 11.001C13.8578 11.001 13.2399 10.7535 12.7749 10.31C12.5665 10.1107 12.2893 9.99952 12.0009 9.99952C11.7126 9.99952 11.4353 10.1107 11.2269 10.31C10.7619 10.7538 10.1438 11.0014 9.50093 11.0014C8.8581 11.0014 8.23997 10.7538 7.77493 10.31C7.56647 10.1104 7.28902 9.99904 7.00043 9.99904C6.71184 9.99904 6.43439 10.1104 6.22593 10.31C5.77677 10.7386 5.1842 10.9848 4.56356 11.0005C3.94291 11.0163 3.33859 10.8006 2.86823 10.3954C2.39787 9.99015 2.09513 9.42439 2.01891 8.80824C1.9427 8.19209 2.09848 7.56962 2.45593 7.062L5.34493 2.878C5.52824 2.60751 5.77502 2.38605 6.06371 2.233C6.35239 2.07994 6.67418 1.99994 7.00093 2H17.0009C17.3267 1.99988 17.6476 2.07934 17.9357 2.23149C18.2238 2.38364 18.4703 2.60386 18.6539 2.873L21.5489 7.065C21.9065 7.57303 22.062 8.19597 21.9854 8.81244C21.9087 9.42891 21.6052 9.99475 21.1341 10.3997C20.663 10.8046 20.058 11.0197 19.437 11.0029C18.816 10.9861 18.2235 10.7388 17.7749 10.309"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M4 10.9502V19.0002C4 19.5306 4.21071 20.0393 4.58579 20.4144C4.96086 20.7895 5.46957 21.0002 6 21.0002H18C18.5304 21.0002 19.0391 20.7895 19.4142 20.4144C19.7893 20.0393 20 19.5306 20 19.0002V10.9502"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </symbol>

    <symbol id={ICON_IDS[1]} viewBox="0 0 24 24" fill="none">
      <path
        d="M3 3V19C3 19.5304 3.21071 20.0391 3.58579 20.4142C3.96086 20.7893 4.46957 21 5 21H21"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M19 9L14 14L10 10L7 13"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </symbol>

    <symbol id={ICON_IDS[2]} viewBox="0 0 24 24" fill="none">
      <path
        d="M8 2V5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M16 2V5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M19 3H5C3.89543 3 3 3.89543 3 5V19C3 20.1046 3.89543 21 5 21H19C20.1046 21 21 20.1046 21 19V5C21 3.89543 20.1046 3 19 3Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M3 9H21"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </symbol>
  </svg>

  <div class="container-page contact__intro">
    {/* Etykieta jest podpisem — nagłówkiem sekcji jest zdanie pod nią. */}
    <p class="contact__eyebrow reveal" style="--reveal-index: 1">{block.eyebrow}</p>
    <h2 id={headingId} class="contact__heading reveal" style="--reveal-index: 2">{block.heading}</h2>
    <p class="contact__lead reveal" style="--reveal-index: 3">{block.description}</p>
  </div>

  <div class="container-page">
    {/*
      Scena, nie sama płyta: obrys 24 px i czerwona łuna leżą POZA płytą, więc
      nie mogą być jej dziećmi — płyta jest przycięta własnym promieniem.
    */}
    <div class="contact__stage reveal" style="--reveal-index: 4">
      <div class="contact__halo" aria-hidden="true"></div>
      <div class="contact__glow" aria-hidden="true"></div>

      <form
        class="contact__panel"
        data-contact-form
        method="post"
        action={block.action || undefined}
      >
        {/*
          Pas kroków to `<ol>` z przyciskami, a NIE `role="tablist"`: to kreator
          formularza, więc strzałki nie mają po nim nawigować. Przyciski są
          `disabled` w HTML — odblokowuje je dopiero skrypt, bo bez JS nie ma
          czego przełączać (progressive enhancement, AGENT-RULES §6).
        */}
        <ol class="contact__rail">
          {
            steps.map((step, index) => (
              <li class="contact__rail-item">
                <button
                  type="button"
                  class="tab"
                  data-step-tab={index}
                  disabled
                  aria-current={index === 0 ? 'step' : 'false'}
                >
                  <svg class="tab__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <use href={`#${ICON_IDS[index]}`} />
                  </svg>
                  <span class="tab__label">{step.label}</span>
                </button>
              </li>
            ))
          }
        </ol>

        {/*
          Wspólna scena kroków. Istnieje dla przejścia, nie dla układu: krok
          odchodzący wypada na chwilę z układu (`position: absolute`), więc musi
          mieć rodzica z `position: relative`, a wysokość, którą skrypt animuje,
          musi mieć gdzie usiąść. Bez JS jest zwykłą kolumną z tym samym
          odstępem, co miały kroki jako dzieci formularza.
        */}
        <div class="steps" data-steps>
          {/* ── Krok 1: cele ─────────────────────────────────────────────── */}
          <fieldset class="step" data-step="0" aria-describedby={errorId}>
            {/*
              `<legend>`, nie `<h3>`: to pytanie do grupy pól, a nie nagłówek
              dokumentu — nagłówkiem sekcji zostaje `<h2>` wyżej.
            */}
            <legend class="step__heading" data-step-heading tabindex="-1">
              {block.goalsStep.heading}
            </legend>
            <p class="step__description">{block.goalsStep.description}</p>

            {/*
              Komunikat jest w DOM od początku i tylko chowany — czytnik ekranu
              musi mieć region, do którego treść wjedzie, zanim się pojawi.
            */}
            <p class="step__error" id={errorId} role="status" hidden>
              {block.goalsStep.errorMessage}
            </p>

            <ul class="options">
              {
                block.goalsStep.options.map((option) => (
                  <li>
                    <label class="option">
                      <input class="option__input" type="checkbox" name="goals" value={option} data-goal />
                      <span class="option__box" aria-hidden="true">
                        <svg class="option__check" viewBox="0 0 13 9" fill="none" focusable="false">
                          <path
                            d="M11.4167 0.75L4.08333 8.08333L0.75 4.75"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                      <span class="option__label">{option}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset>

          {/* ── Krok 2: dane kontaktowe ──────────────────────────────────── */}
          <div class="step" data-step="1">
            <p class="step__heading" data-step-heading tabindex="-1">{block.detailsStep.heading}</p>
            <p class="step__description">{block.detailsStep.description}</p>

            <div class="fields">
              {
                block.detailsStep.fields.map((field) => (
                  <label class="field">
                    {/*
                      Kolejność jest tu kontraktem, nie stylem: etykieta stoi PO
                      polu, bo pływa na `:placeholder-shown` sąsiada, a CSS nie
                      umie sięgnąć wstecz. `placeholder=" "` (spacja, nie pusty
                      string) jest tym, co w ogóle włącza ten stan.
                    */}
                    <input
                      class="field__input"
                      type={field.type}
                      name={field.name}
                      placeholder=" "
                      required={field.required}
                      autocomplete={field.autocomplete}
                      data-field-label={field.label}
                    />
                    <span class="field__label">{field.label}</span>
                  </label>
                ))
              }
            </div>
          </div>

          {/* ── Krok 3: przegląd, zgoda, wysyłka ─────────────────────────── */}
          <div class="step" data-step="2">
            <p class="step__heading" data-step-heading tabindex="-1">{block.summaryStep.heading}</p>
            <p class="step__description">{block.summaryStep.description}</p>

            {/*
              Przegląd wypełnia skrypt z tego, co użytkownik zaznaczył i wpisał.
              Bez JS nie ma czego streszczać — stąd `hidden` w HTML, zdejmowane
              przy starcie skryptu.
            */}
            <div class="summary" data-summary hidden>
              <dl class="summary__list">
                <div class="summary__row">
                  <dt class="summary__term">{block.summaryStep.goalsLabel}</dt>
                  <dd class="summary__value" data-summary-goals>{block.summaryStep.emptyLabel}</dd>
                </div>
                <div class="summary__row">
                  <dt class="summary__term">{block.summaryStep.detailsLabel}</dt>
                  <dd class="summary__value" data-summary-details>{block.summaryStep.emptyLabel}</dd>
                </div>
              </dl>
            </div>

            <label class="consent">
              <input class="option__input" type="checkbox" name="consent" required />
              <span class="option__box" aria-hidden="true">
                <svg class="option__check" viewBox="0 0 13 9" fill="none" focusable="false">
                  <path
                    d="M11.4167 0.75L4.08333 8.08333L0.75 4.75"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              {/*
                Jedyna treść bloku ze znacznikiem — zgoda niesie link do Polityki
                Prywatności, więc jest `RichText`, a nie zwykłym stringiem.
              */}
              <span class="consent__label" set:html={block.summaryStep.consent} />
            </label>
          </div>
        </div>

        <div class="contact__actions">
          {/*
            „Wstecz" i „Dalej" mają sens wyłącznie przy działającym JS — bez
            niego wszystkie kroki są widoczne naraz, więc startują ukryte
            i odsłania je skrypt. „Wyślij" jest widoczny zawsze.
          */}
          <button type="button" class="button button--ghost btn-wipe" data-back hidden>
            {block.backLabel}
          </button>

          <button type="button" class="button button--primary btn-wipe" data-next hidden>
            {block.nextLabel}
          </button>

          <button type="submit" class="button button--primary btn-wipe" data-submit disabled={!canSubmit}>
            {block.summaryStep.submitLabel}
          </button>
        </div>

      </form>
    </div>
  </div>
</section>

<script>
  /*
   * Kreator formularza. Jedyny JS w tym bloku i jedyny na stronie głównej poza
   * hero — uzasadnienie i odrzucone alternatywy w Contact.spec.md → „Budżet".
   *
   * Kontrakt z HTML-em: bez tego skryptu formularz działa jako jedna długa
   * lista pól z natywną walidacją. Skrypt tylko ZWĘŻA to do jednego kroku
   * naraz, więc awaria ładowania nie zabiera funkcji, a wygodę.
   */
  type Nav = HTMLButtonElement

  function setupForm(form: HTMLFormElement) {
    const tabs = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-step-tab]'))
    const panels = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'))
    const stage = form.querySelector<HTMLElement>('[data-steps]')
    const next = form.querySelector<Nav>('[data-next]')
    const back = form.querySelector<Nav>('[data-back]')
    const submit = form.querySelector<Nav>('[data-submit]')
    const error = form.querySelector<HTMLElement>('#contact-goals-error')
    const summary = form.querySelector<HTMLElement>('[data-summary]')
    const summaryGoals = form.querySelector<HTMLElement>('[data-summary-goals]')
    const summaryDetails = form.querySelector<HTMLElement>('[data-summary-details]')

    if (!next || !back || !submit || panels.length === 0) return

    const nav = { next, back, submit }
    const last = panels.length - 1
    let current = 0
    /* Najdalszy odwiedzony krok — do niego (i tylko do niego) wolno skoczyć. */
    let reached = 0

    /*
     * Czas i dystans przejścia mieszkają w tokenach, nie tutaj — skrypt tylko
     * je odczytuje, i to przy KAŻDEJ zamianie, nie raz na starcie: w chwili,
     * gdy `<script>` się wykonuje, `getComputedStyle` potrafi jeszcze zwrócić
     * dla custom property pusty string (arkusz nie jest policzony). Odczyt raz
     * na starcie dawał więc czas 0 i przejście, którego nie widać.
     *
     * PUŁAPKA (PLAYBOOK P-058): jednostka nie jest tą, którą napisano
     * w tokenach — Lightning CSS skraca `380ms` do `.38s`, więc samo
     * `parseFloat` daje 0,38 i całe przejście trwa pół klatki. Lokalnie
     * niewidoczne: `astro dev` nie minifikuje.
     */
    const motionOff = window.matchMedia('(prefers-reduced-motion: reduce)')

    const readMs = (value: string) => {
      const amount = Number.parseFloat(value)
      if (!Number.isFinite(amount)) return 0
      return /ms$/.test(value.trim()) ? amount : amount * 1000
    }

    const swapMotion = () => {
      const tokens = getComputedStyle(form)
      const duration = readMs(tokens.getPropertyValue('--contact-step-swap-duration'))
      return {
        duration,
        shift: tokens.getPropertyValue('--contact-step-swap-shift').trim() || '0px',
        easing: tokens.getPropertyValue('--ease-out-expo').trim() || 'ease-out',
        /*
         * Ruch jest wygodą, nie funkcją: przy `prefers-reduced-motion`
         * (AGENT-RULES §6) i w przeglądarce bez Web Animations krok podmienia
         * się natychmiast, dokładnie jak przed tą zmianą. Pytanie zadajemy przy
         * każdej zamianie, bo ustawienie systemowe da się przełączyć bez
         * przeładowania strony.
         */
        allowed:
          Boolean(stage) &&
          duration > 0 &&
          !motionOff.matches &&
          'animate' in Element.prototype,
      }
    }

    /* Sprzątanie po kroku, który jeszcze odjeżdża. Ustawiane przez `swap`. */
    let endLeave: (() => void) | null = null
    let heightAnimation: Animation | null = null

    /*
     * Przejście między krokami. Trzy ruchy w jednym zdarzeniu dla oka: krok
     * odchodzący zanika i cofa się, wchodzący przypływa z przeciwnej strony,
     * a scena dojeżdża ze starej wysokości do nowej. Kierunek niesie znak —
     * „dalej" przesuwa treść w lewo, „wstecz" w prawo.
     */
    const swap = (from: number, to: number) => {
      const outgoing = panels[from]
      const incoming = panels[to]

      endLeave?.()
      const motion = swapMotion()

      if (!stage || !outgoing || !incoming || from === to || !motion.allowed) {
        panels.forEach((panel, position) => {
          panel.hidden = position !== to
        })
        return
      }

      /*
       * Wysokość czytana PRZED anulowaniem poprzedniej animacji: przy szybkim
       * klikaniu nowe przejście ma ruszyć stamtąd, gdzie scena właśnie jest,
       * a nie skoczyć do wysokości kroku, którego nikt już nie ogląda.
       */
      const startHeight = stage.getBoundingClientRect().height
      heightAnimation?.cancel()

      panels.forEach((panel, position) => {
        panel.hidden = position !== to
      })
      const endHeight = stage.getBoundingClientRect().height

      const direction = to > from ? 1 : -1
      const away = `translate3d(calc(${motion.shift} * ${-direction}), 0, 0)`
      const toward = `translate3d(calc(${motion.shift} * ${direction}), 0, 0)`
      const rest = 'translate3d(0, 0, 0)'

      /* Odchodzący wraca do DOM jako warstwa poza układem — patrz `.step--leaving`. */
      outgoing.hidden = false
      outgoing.classList.add('step--leaving')
      outgoing.setAttribute('aria-hidden', 'true')
      stage.setAttribute('data-swapping', '')

      const leave = outgoing.animate([{ opacity: 1, transform: rest }, { opacity: 0, transform: away }], {
        /* Nie połowa całości, tylko mniej: oba kroki mają tekst wyśrodkowany
           w tym samym miejscu, więc przenikanie „na krzyż" daje na chwilę dwa
           czytelne napisy jeden na drugim. Odchodzący ma zdążyć zniknąć, zanim
           wchodzący zacznie się pojawiać — stąd 0,45 tu i opóźnienie 0,35 tam. */
        duration: motion.duration * 0.45,
        easing: motion.easing,
        fill: 'forwards',
      })

      let leaveDone = false
      const finishLeave = () => {
        if (leaveDone) return
        leaveDone = true
        leave.cancel()
        outgoing.classList.remove('step--leaving')
        outgoing.removeAttribute('aria-hidden')
        outgoing.hidden = outgoing !== panels[current]
        if (endLeave === finishLeave) endLeave = null
      }
      endLeave = finishLeave
      leave.onfinish = finishLeave

      incoming.animate([{ opacity: 0, transform: toward }, { opacity: 1, transform: rest }], {
        duration: motion.duration * 0.65,
        delay: motion.duration * 0.35,
        easing: motion.easing,
        fill: 'backwards',
      })

      const height = stage.animate([{ height: `${startHeight}px` }, { height: `${endHeight}px` }], {
        duration: motion.duration,
        easing: motion.easing,
      })
      /* Przycięcie znika razem z RUCHEM WYSOKOŚCI, nie z zanikiem — do tego
         momentu wyższy krok wystawałby na przyciski. Warunek `=== height`
         pilnuje, żeby zdarzenie anulowanej animacji nie zdjęło przycięcia
         przejściu, które właśnie zaczęło się w jej miejscu. */
      const releaseClip = () => {
        if (heightAnimation !== height) return
        stage.removeAttribute('data-swapping')
        heightAnimation = null
      }
      height.onfinish = releaseClip
      height.oncancel = releaseClip
      heightAnimation = height
    }

    /* Pierwszy przebieg `show` tylko ustawia stan początkowy — nie ma go
       animować, bo nikt niczego jeszcze nie kliknął. */
    let ready = false

    /* `hidden` zdejmowane z przejściem: przycisk „wstecz" pojawia się razem
       z krokiem, a nie klatkę przed nim. */
    const setNavHidden = (button: Nav, hidden: boolean) => {
      const appearing = button.hidden && !hidden
      button.hidden = hidden
      if (!appearing || !ready) return

      const motion = swapMotion()
      if (!motion.allowed) return
      button.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: motion.duration,
        easing: motion.easing,
      })
    }

    /*
     * Funkcje jako `const`, nie deklaracje: deklaracja jest wyciągana na górę
     * zakresu, więc TypeScript nie może w niej zaufać zawężeniu z `if` wyżej.
     * Kolejność definicji jest tu więc częścią kontraktu, nie stylem.
     */
    const validate = (index: number) => {
      if (index === 0) {
        const chosen = form.querySelectorAll('[data-goal]:checked').length > 0
        if (error) error.hidden = chosen
        return chosen
      }

      const panel = panels[index]
      if (!panel) return true

      const inputs = Array.from(panel.querySelectorAll<HTMLInputElement>('input'))
      const invalid = inputs.find((input) => !input.checkValidity())
      if (invalid) {
        invalid.reportValidity()
        return false
      }
      return true
    }

    const fillSummary = () => {
      if (!summaryGoals || !summaryDetails) return

      /* Teksty „nie podano" przychodzą z fixture'a — zapamiętujemy je przy
         pierwszym przebiegu, zanim je nadpiszemy odpowiedziami. */
      summaryGoals.dataset.empty ??= summaryGoals.textContent ?? ''
      summaryDetails.dataset.empty ??= summaryDetails.textContent ?? ''

      const goals = Array.from(form.querySelectorAll<HTMLInputElement>('[data-goal]:checked')).map(
        (input) => input.value,
      )
      summaryGoals.textContent =
        goals.length > 0 ? goals.join(', ') : (summaryGoals.dataset.empty ?? '')

      const details = Array.from(form.querySelectorAll<HTMLInputElement>('[data-field-label]'))
        .filter((input) => input.value.trim() !== '')
        .map((input) => `${input.dataset.fieldLabel}: ${input.value.trim()}`)
      summaryDetails.textContent =
        details.length > 0 ? details.join(' · ') : (summaryDetails.dataset.empty ?? '')
    }

    const show = (index: number, moveFocus: boolean) => {
      const previous = current
      current = Math.min(Math.max(index, 0), last)
      reached = Math.max(reached, current)

      swap(previous, current)
      tabs.forEach((tab, position) => {
        tab.setAttribute('aria-current', position === current ? 'step' : 'false')
        tab.disabled = position > reached
      })

      setNavHidden(nav.back, current === 0)
      setNavHidden(nav.next, current === last)
      setNavHidden(nav.submit, current !== last)

      if (current === last) fillSummary()

      if (!moveFocus) return
      /*
       * Fokus na nagłówek kroku, nie na pierwsze pole: czytnik ekranu ma
       * najpierw usłyszeć, GDZIE jest, a dopiero potem co ma wypełnić.
       *
       * `preventScroll` jest tu warunkiem płynności: fokus na elemencie, który
       * właśnie przypływa w scenie o zmieniającej się wysokości, kazałby
       * przeglądarce dociągnąć stronę do celu liczonego w POŁOWIE ruchu — czyli
       * szarpnąć scrollem. Płyta i tak jest w kadrze, bo użytkownik przed chwilą
       * kliknął w niej przycisk.
       */
      panels[current]
        ?.querySelector<HTMLElement>('[data-step-heading]')
        ?.focus({ preventScroll: true })
    }

    if (summary) summary.hidden = false

    tabs.forEach((tab, index) => {
      tab.disabled = index > reached
      tab.addEventListener('click', () => {
        if (index <= reached) show(index, true)
      })
    })

    nav.next.addEventListener('click', () => {
      if (validate(current)) show(current + 1, true)
    })
    nav.back.addEventListener('click', () => show(current - 1, true))

    /*
     * Pola wymagane siedzą w krokach ukrytych atrybutem `hidden`, a takich
     * przeglądarka nie potrafi sfokusować przy natywnej walidacji („An invalid
     * form control is not focusable"). Dlatego przy wysyłce sami wracamy do
     * kroku z pierwszym niepoprawnym polem.
     */
    form.addEventListener('submit', (event) => {
      const invalid = form.querySelector<HTMLInputElement>('input:invalid')
      if (!invalid) return

      event.preventDefault()
      const panel = invalid.closest<HTMLElement>('[data-step]')
      const index = panel ? panels.indexOf(panel) : -1
      if (index >= 0) show(index, true)
      invalid.reportValidity()
    })

    show(0, false)
    ready = true
  }

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(setupForm)
</script>

<style>
