  .contact__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /*
    Wygaszenie kadru u góry i u dołu. Oba pasy są dziećmi kadru, nie sekcji:
    dzięki temu malują się NAD zdjęciem i pod treścią, bez dokładania warstwie
    tła własnego `z-index`.
  */
  .contact__backdrop::before,
  .contact__backdrop::after {
    content: '';
    position: absolute;
    inset-inline: 0;
