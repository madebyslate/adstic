    padding: var(--contact-panel-padding);
    border-radius: var(--contact-panel-radius);
    background-color: var(--contact-panel-bg);
  }

  /* ── Pas kroków ───────────────────────────────────────────────────────── */

  .contact__rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--contact-rail-gap);
    margin: 0;
    padding: var(--contact-rail-gap);
    border-radius: var(--contact-rail-radius);
    background-color: var(--contact-rail-bg);
    list-style: none;
    opacity: var(--contact-tab-opacity);
  }

  .contact__rail-item {
    display: flex;
    min-width: 0;
  }

  .tab {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--contact-tab-gap);
    min-width: 0;
    padding: var(--contact-tab-padding);
    border: 1px solid transparent;
    border-radius: var(--contact-tab-radius);
    background-color: var(--contact-tab-bg);
    color: var(--contact-tab-fg);
    font: inherit;
    font-size: var(--text-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-tight);
    text-align: start;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }

  /*
    Gradient aktywnego kafla jest OSOBNĄ warstwą, nie tłem taba: `background`
    nie interpoluje między kolorem a gradientem, więc podmiana wprost skakałaby
    o klatkę, podczas gdy obrys i tekst płynnie dojeżdżają. Warstwa siada pod
    obrysem (`inset: -1px`), żeby kafel nie miał ciemnej obwódki w środku.
  */
  .tab::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--contact-tab-bg-active);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  /* Krok odwiedzony wraca kliknięciem — nieodwiedzony jest `disabled`. */
  .tab:not(:disabled) {
    cursor: pointer;
  }

  .tab[aria-current='step'] {
    border-color: var(--contact-tab-border-active);
    box-shadow: var(--shadow-contact-tab);
    color: var(--color-fg);
  }

  .tab[aria-current='step']::before {
    opacity: 1;
  }

  /*
    Ikona i podpis muszą być POZYCJONOWANE, choć nigdzie się nie przesuwają:
    warstwa gradientu (`::before`) jest `absolute`, a element pozycjonowany
    maluje się nad zwykłą treścią niezależnie od kolejności w drzewie. Bez tego
    aktywny kafel jest pustym prostokątem — i to nie rzuca żadnego błędu.
  */
  .tab__icon,
  .tab__label {
    position: relative;
  }

  .tab__icon {
    flex: none;
    width: var(--contact-tab-icon-size);
    height: var(--contact-tab-icon-size);
  }

  .tab__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Krok ─────────────────────────────────────────────────────────────── */

  /*
    Scena kroków. `position: relative` jest tu wymogiem przejścia, nie ozdobą:
    krok odchodzący dostaje `position: absolute` i musi się zaczepić o scenę,
    a nie o płytę. Odstęp i kierunek układu przejęte po formularzu — bez JS
    scena jest przezroczysta dla oka.
  */
  .steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /*
    Przycięcie WYŁĄCZNIE na czas przejścia. Na stałe obcinałoby pierścień fokusa
    i dymki natywnej walidacji, które wychodzą poza pudełko kroku; w trakcie
    zamiany jest odwrotnie — bez niego treść wyższego kroku wylewa się na
    przyciski, zanim wysokość sceny do niej dojedzie.
  */
  .steps[data-swapping] {
    overflow: clip;
  }

  /*
    Krok odchodzący: wypada z układu, żeby wchodzący mógł od razu zająć jego
    miejsce (przenikanie, nie kolejka dwóch ruchów). `pointer-events: none`,
    bo przez ~0,4 s leży na wierzchu i przechwyciłby kliknięcie w treść pod nim.
  */
  .step--leaving {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    pointer-events: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 0;
    border: 0;
    text-align: center;
  }

  /* `hidden` musi wygrać z `display: flex` — stąd selektor z klasą, nie sam atrybut. */
  .step[hidden] {
    display: none;
  }

  .step__heading {
    padding: 0;
    color: var(--color-fg);
    font-size: var(--contact-step-heading-size);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-snug);
  }

  .step__description {
    margin: var(--space-1) 0 0;
    color: var(--color-fg-faint);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .step__error {
    margin: var(--space-3) 0 0;
    color: var(--color-brand-glow);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .step__error[hidden] {
    display: none;
  }

  /* ── Kontrolki ────────────────────────────────────────────────────────── */

  .options,
  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .option,
  .consent {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--contact-field-padding);
    border: 1px solid var(--contact-field-border);
    border-radius: var(--contact-field-radius);
    background: var(--contact-field-bg);
    color: var(--color-fg);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    text-align: start;
    transition:
      background var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .option,
  .consent {
    cursor: pointer;
  }

  .option:hover,
  .consent:hover {
    background: var(--contact-field-bg-hover);
  }

  .option:has(.option__input:checked),
  .consent:has(.option__input:checked) {
    border-color: var(--color-brand);
  }

  /*
    Natywny checkbox zostaje w DOM i przyjmuje fokus — znika tylko z widoku,
    a jego rolę wizualną przejmuje kwadrat obok. Bez tego traci się klawiaturę
    i wysyłkę wartości.
  */
  .option__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .option__box {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--contact-check-size);
    height: var(--contact-check-size);
    border: 1px solid var(--contact-field-border);
    border-radius: var(--contact-check-radius);
  }

  .option__check {
    width: var(--cta-badge-icon-width);
    height: var(--cta-badge-icon-height);
    color: var(--color-fg);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .option__input:checked ~ .option__box {
    border-color: var(--color-brand);
    background-color: var(--color-brand);
  }

  .option__input:checked ~ .option__box .option__check {
    opacity: 1;
  }

  /* Fokus jest na ukrytym `<input>`, więc obrys rysuje otaczająca etykieta. */
  .option:has(.option__input:focus-visible),
  .consent:has(.option__input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .option__label,
  .consent__label {
    min-width: 0;
  }

  /*
    `width: 100%` jest tu wymogiem, nie ozdobą: `.step` układa dzieci w kolumnie
    z `align-items: center`, więc element bez podanej szerokości kurczy się do
    treści — a wiersz zgody stoi tuż pod przeglądem, który ma 100 %, i każda
    różnica jest natychmiast widoczna jako przesunięta krawędź.
  */
  .consent {
    align-items: start;
    width: 100%;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  /*
    Kwadracik zgody równa się do PIERWSZEGO WIERSZA tekstu, nie do jego pudełka.
    `align-items: start` jest tu konieczne (zgoda łamie się na dwa wiersze na
    wąskim ekranie i wtedy `center` odsunąłby znacznik na środek akapitu), ale
    samo „start" stawia 16-pikselowy kwadrat przy górnej krawędzi 21-pikselowego
    wiersza — stąd widoczne przesunięcie o ~2 px w górę. Zsuwamy go o połowę
    różnicy między wysokością wiersza a kwadratem.
  */
  .consent .option__box {
    margin-block-start: calc(
      (var(--text-sm) * var(--leading-normal) - var(--contact-check-size)) / 2
    );
  }

  .consent__label :global(a) {
    color: var(--color-fg);
  }

  /*
    Pole z pływającą etykietą. Etykieta NAD polem kosztowała 64 px wysokości
    przy 16 px treści — cztery takie pola robiły z kroku 2 ścianę. Tu etykieta
    zaczyna jako placeholder i odjeżdża w górę, więc jedno pudełko niesie oba
    stany i wysokość spada do 52 px.
  */
  .field {
    position: relative;
    display: block;
    height: var(--contact-field-height);
    border: 1px solid var(--contact-field-border);
    border-radius: var(--contact-field-radius);
    background: var(--contact-field-bg);
    transition: border-color var(--duration-base) var(--ease-standard);
  }

  .field:hover {
    border-color: var(--contact-field-border-hover);
  }

  /*
    Czerwony pierścień na focusie. Osobna warstwa z animowanym `opacity`,
    a nie `box-shadow` przechodzący z przezroczystego — cień animuje się na
    głównym wątku, `opacity` na kompozytorze (AGENT-RULES §6).
  */
  .field::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-brand);
    border-radius: inherit;
    box-shadow: var(--shadow-contact-field-focus);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-standard);
    pointer-events: none;
  }

  .field:focus-within::after {
    opacity: 1;
  }

  .field__input {
    width: 100%;
    height: 100%;
    /* Górny padding robi miejsce etykiecie, która na focusie tam wjeżdża. */
    padding: var(--contact-field-input-padding);
    border: 0;
    background: none;
    color: var(--color-fg);
    caret-color: var(--color-brand);
    font: inherit;
    font-size: var(--text-base);
    line-height: var(--leading-tight);
  }

  /* Obrys focusa rysuje `::after`, nie przeglądarka — inaczej ramka jest podwójna. */
  .field__input:focus-visible {
    outline: none;
  }

  /*
    Placeholder istnieje wyłącznie po to, żeby `:placeholder-shown` miało czym
    być — widoczna jest etykieta, nie on.
  */
  .field__input::placeholder {
    color: transparent;
  }

  /*
    Chrome maluje autouzupełnione pole na jasno i ignoruje `background`.
    Przebija to tylko cień `inset` — stąd ta reguła, a nie `background-color`.
  */
  .field__input:autofill {
    box-shadow: inset 0 0 0 100vmax var(--contact-field-autofill);
    -webkit-text-fill-color: var(--color-fg);
  }

  .field__label {
    position: absolute;
    inset-inline-start: var(--contact-field-label-inset);
    inset-block-start: 50%;
    /* Punkt zaczepienia w lewym górnym rogu — inaczej zmniejszona etykieta
       odpłynęłaby od krawędzi pola. */
    transform-origin: left top;
    translate: 0 -50%;
    color: var(--color-fg-faint);
    font-size: var(--text-base);
    line-height: var(--leading-tight);
    /* `translate` i `scale` jako osobne właściwości, nie `transform`: dzięki
       temu stan pływający nadpisuje samo przesunięcie, bez powtarzania skali. */
    transition:
      translate var(--duration-base) var(--ease-standard),
      scale var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
    pointer-events: none;
  }

  /*
    Dwa warunki, nie jeden: pole sfokusowane (etykieta ustępuje miejsca kursorowi)
    ORAZ pole wypełnione (etykieta musi zostać u góry po odejściu fokusa).
  */
  .field__input:focus + .field__label,
  .field__input:not(:placeholder-shown) + .field__label {
    translate: 0 var(--contact-field-label-lift);
    scale: var(--contact-field-label-scale);
  }

  .field__input:focus + .field__label {
    color: var(--color-fg);
  }

  /* ── Przegląd (krok 3) ────────────────────────────────────────────────── */

  .summary {
    width: 100%;
    margin-top: var(--space-6);
    padding: var(--contact-field-padding);
    border: 1px solid var(--contact-field-border);
    border-radius: var(--contact-field-radius);
    background: var(--contact-field-bg);
    text-align: start;
  }

  .summary[hidden] {
    display: none;
  }

  .summary__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .summary__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .summary__term {
    color: var(--color-fg-faint);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .summary__value {
    margin: 0;
    color: var(--color-fg);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  /* ── Akcje ────────────────────────────────────────────────────────────── */

  .contact__actions {
    display: flex;
    gap: var(--space-3);
  }

  .button {
    flex: 1;
    padding: var(--control-padding-y) var(--control-padding-x);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
