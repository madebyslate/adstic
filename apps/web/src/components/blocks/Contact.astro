  }

  .contact__eyebrow::before {
    content: '';
    width: var(--space-1);
    height: var(--space-1);
    background-color: var(--color-brand);
  }

  .contact__heading {
    max-width: var(--contact-heading-width);
    margin: 0;
    /* 96 px dotyczy desktopu — na 390 px zostawiałoby jedno słowo w wierszu. */
    font-size: var(--text-4xl);
    line-height: var(--leading-snug);
    /*
      Gradient malowany PRZEZ litery. `color` zostaje kremem, a nie
      `transparent`: gdy przeglądarka nie zna `background-clip: text`
      (albo tryb wysokiego kontrastu go wyłącza), tekst dalej jest widoczny.
    */
    color: var(--color-fg);
    background-image: var(--gradient-heading);
    background-clip: text;
    -webkit-background-clip: text;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
