---
import type { StatIcon, WhoWeAreBlock } from '@repo/shared'
import AvatarLink from '@/components/ui/AvatarLink.astro'
import Picture from '@/components/ui/Picture.astro'

interface Props {
  block: WhoWeAreBlock
}

const { block } = Astro.props
const headingId = 'who-we-are-heading'

/*
 * Podział na słowa robimy przy buildzie, nie w przeglądarce: odsłanianie
 * na scrollu jest czystym CSS-em (`animation-timeline: view()`), więc blok
 * kosztuje 0 KB JS. Cena to kilkadziesiąt <span> w HTML — tańsze niż skrypt,
 * który i tak musiałby te spany utworzyć, tylko po hydratacji.
 */
const words = block.body.trim().split(/\s+/)

/*
 * Każde słowo dostaje własny wycinek postępu przewijania. Zakres startuje po
 * wejściu sekcji w kadr (15%) i domyka się przed jej wyjściem (70%), a okno
 * pojedynczego słowa jest trzy razy szersze niż krok — dzięki temu sąsiednie
 * słowa rozjaśniają się z zakładką i widać falę, a nie migające litery.
 */
const REVEAL_FROM = 15
const REVEAL_TO = 70
const step = (REVEAL_TO - REVEAL_FROM) / words.length

const reveal = words.map((word, index) => {
  const from = REVEAL_FROM + index * step
  return {
    word,
    range: `cover ${from.toFixed(2)}% cover ${Math.min(from + step * 3, 100).toFixed(2)}%`,
  }
})

/*
 * Ikony kafli są rysunkiem z makiety, nie treścią — dlatego ścieżki siedzą tu,
 * a dane niosą tylko nazwę znaczenia (patrz `StatIcon` w @repo/shared).
 * `stroke` bierze się z `currentColor`, żeby kolor szedł z tokenu, nie z pliku.
 */
const ICON_PATHS: Record<StatIcon, string[]> = {
  award: [
    'M15.4748 12.8906L16.9898 21.4166C17.0068 21.517 16.9927 21.6202 16.9494 21.7124C16.9062 21.8046 16.8358 21.8813 16.7477 21.9324C16.6597 21.9835 16.5581 22.0065 16.4566 21.9983C16.3551 21.9902 16.2585 21.9512 16.1798 21.8866L12.5998 19.1996C12.427 19.0705 12.217 19.0007 12.0013 19.0007C11.7856 19.0007 11.5756 19.0705 11.4028 19.1996L7.8168 21.8856C7.73812 21.9501 7.64166 21.989 7.54029 21.9972C7.43893 22.0054 7.33747 21.9825 7.24946 21.9315C7.16145 21.8805 7.09107 21.804 7.04772 21.712C7.00436 21.62 6.99009 21.5169 7.0068 21.4166L8.5208 12.8906',
    'M12 14C15.3137 14 18 11.3137 18 8C18 4.68629 15.3137 2 12 2C8.68629 2 6 4.68629 6 8C6 11.3137 8.68629 14 12 14Z',
  ],
  chart: [
    'M13 17V9',
    'M18 17V5',
    'M3 3V19C3 19.5304 3.21071 20.0391 3.58579 20.4142C3.96086 20.7893 4.46957 21 5 21H21',
    'M8 17V14',
  ],
  tag: [
    'M11 17L13 19C13.197 19.197 13.4308 19.3532 13.6882 19.4598C13.9456 19.5665 14.2214 19.6213 14.5 19.6213C14.7786 19.6213 15.0544 19.5665 15.3118 19.4598C15.5692 19.3532 15.803 19.197 16 19C16.197 18.803 16.3532 18.5692 16.4598 18.3118C16.5665 18.0544 16.6213 17.7786 16.6213 17.5C16.6213 17.2214 16.5665 16.9456 16.4598 16.6882C16.3532 16.4308 16.197 16.197 16 16',
    'M14.0002 14.0005L16.5002 16.5005C16.8981 16.8983 17.4376 17.1218 18.0002 17.1218C18.5628 17.1218 19.1024 16.8983 19.5002 16.5005C19.8981 16.1027 20.1215 15.5631 20.1215 15.0005C20.1215 14.4379 19.8981 13.8983 19.5002 13.5005L15.6202 9.6205C15.0577 9.0587 14.2952 8.74314 13.5002 8.74314C12.7052 8.74314 11.9427 9.0587 11.3802 9.6205L10.5002 10.5005C10.1024 10.8983 9.56284 11.1218 9.00023 11.1218C8.43762 11.1218 7.89805 10.8983 7.50023 10.5005C7.1024 10.1027 6.87891 9.56311 6.87891 9.0005C6.87891 8.43789 7.1024 7.89833 7.50023 7.5005L10.3102 4.6905C11.2225 3.78065 12.4121 3.20106 13.6909 3.04348C14.9696 2.8859 16.2644 3.15933 17.3702 3.8205L17.8402 4.1005C18.266 4.35749 18.7723 4.44662 19.2602 4.3505L21.0002 4.0005',
    'M21 3L22 14H20',
    'M3 3L2 14L8.5 20.5C8.89782 20.8978 9.43739 21.1213 10 21.1213C10.5626 21.1213 11.1022 20.8978 11.5 20.5C11.8978 20.1022 12.1213 19.5626 12.1213 19C12.1213 18.4374 11.8978 17.8978 11.5 17.5',
    'M3 4H11',
  ],
}
---

{/*
  Wejście sekcji. Grupa trzyma wszystkie animacje w środku na pierwszej klatce,
  dopóki obserwator w BaseLayout nie uzna, że warto ją odegrać — mechanizm jest
  opisany przy „W polu widzenia" w global.css.
*/}
<section class="who" aria-labelledby={headingId} data-reveal-group>
  <div class="container-page">
    <div class="who__grid">
      <div class="who__intro">
        {/* Etykieta sekcji jest jej nagłówkiem — tak samo jak w TrustedBy. */}
        <h2 id={headingId} class="who__eyebrow reveal" style="--reveal-index: 0">{block.eyebrow}</h2>

        <p class="who__text reveal" style="--reveal-index: 1">
          <span class="who__lead">{block.lead}</span>{' '}
          {
            reveal.map(({ word, range }) => (
              <>
                <span class="who__word">
                {/*
                  Jasna kopia leży NA przygaszonym słowie i pojawia się przez
                  `opacity` — animujemy więc wyłącznie kompozycję (AGENT-RULES
                  §6). Animowanie `color` dawałoby ten sam efekt kosztem
                  repaintu całego akapitu na każdej klatce scrolla.
                */}
                  <span class="who__word-bright" style={`animation-range: ${range}`} aria-hidden="true">
                    {word}
                  </span>
                  {word}
                </span>{' '}
              </>
            ))
          }
        </p>
      </div>

      <div class="who__aside">
        {/*
          Kreska w tle z wędrującym światłem. Czysta dekoracja — poza drzewem
          dostępności. `flex: 1` sprawia, że kreska wypełnia dokładnie tyle,
          ile zostało nad akapitem, więc jej długość wynika z układu, a nie
          z wpisanej na sztywno wysokości.
        */}
        <div class="who__rail reveal-rule" style="--reveal-index: 1" aria-hidden="true">
          <span class="who__rail-light"></span>
        </div>

        <p class="who__note reveal" style="--reveal-index: 2">{block.note}</p>

        <AvatarLink link={block.cta} class="reveal" style="--reveal-index: 3" />
      </div>

      {
        block.cards.map((card, index) =>
          card.kind === 'person' ? (
            <figure class={`card card--person card--slot-${index + 1} reveal`} style={`--reveal-index: ${index + 2}`}>
              <div class="card__media">
                <Picture image={card.photo} widths={[200, 400]} sizes="(min-width: 1024px) 200px, 45vw" />
                {card.badge && (
                  <span class="card__badge">
                    <span class="card__badge-dot" aria-hidden="true" />
                    {card.badge}
                  </span>
                )}
              </div>
              <figcaption class="card__name">{card.name}</figcaption>
            </figure>
          ) : (
            <div class={`card card--stat card--slot-${index + 1} reveal`} style={`--reveal-index: ${index + 2}`}>
              <svg
                class="card__icon"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {ICON_PATHS[card.icon].map((d) => (
                  <path d={d} stroke="currentColor" />
                ))}
              </svg>

              <p class="card__value">{card.value}</p>
              <p class="card__description">{card.description}</p>
            </div>
          ),
        )
      }
    </div>
  </div>
</section>

<style>
  .who {
    padding-block: var(--section-padding-y);
    /* Tło jest tłem strony — sekcja go nie maluje. */
  }

  .who__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  /* ── Nagłówek i tekst odsłaniany ────────────────────────────────────────── */

  .who__intro {
    grid-column: 1 / -1;
    margin-block-end: var(--space-5);
  }

  .who__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .who__eyebrow::before {
    content: '';
    width: var(--space-1);
    height: var(--space-1);
    background-color: var(--color-brand);
  }

  .who__text {
    margin: 0;
    color: var(--color-fg-dim);
    font-family: var(--font-heading);
    /* 36 px z makiety dotyczy desktopu — na 390 px dawałoby 3 słowa w wierszu. */
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-display);
    /* Zdanie ma się łamać jak w makiecie — nie wyrównujemy długości wierszy. */
    text-wrap: pretty;
  }

  .who__lead {
    color: var(--color-fg);
  }

  .who__word {
    position: relative;
    /* Bez tego jasna kopia mogłaby się złamać inaczej niż słowo pod spodem. */
    white-space: nowrap;
  }

  .who__word-bright {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    color: var(--color-fg);
    pointer-events: none;
  }

  /*
   * Odsłanianie działa tylko tam, gdzie przeglądarka zna oś scrolla. Gdzie nie
   * zna — tekst jest po prostu jasny od razu, bo nieczytelny akapit nie jest
   * akceptowalnym fallbackiem.
   */
  @supports (animation-timeline: view()) {
    .who__word-bright {
      opacity: 0;
      /*
       * PUŁAPKA (PLAYBOOK P-050): longhandy, nie skrót `animation`. Skrót razem
       * z `animation-timeline` minifikator składa w `animation: … view()`,
       * czego Chrome nie przyjmuje — a przy `opacity: 0` wyżej znaczyło to, że
       * na buildzie te słowa były NIEWIDOCZNE. Dev tego nie pokazuje.
       */
      animation-name: who-reveal;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      /* `animation-range` jest inline — każde słowo ma własny wycinek. */
    }
  }

  @keyframes who-reveal {
    to {
      opacity: 1;
    }
  }

  /* ── Lewa kolumna: kreska, obietnica, CTA ───────────────────────────────── */

  .who__aside {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cta-gap);
    /* Blok siada przy dolnej krawędzi siatki kafli (patrz breakpoint lg). */
    order: 1;
    margin-block-start: var(--space-5);
  }

  .who__rail {
    /* Na wąskich ekranach nie ma nad czym rysować pionowej kreski. */
    display: none;
    /*
      `reveal-rule` domyślnie rozciąga kreskę od dołu. Tutaj ma rosnąć od góry,
      bo światło, które po niej jedzie, startuje przy górnej krawędzi — kreska
      rosnąca w przeciwną stronę niż jej własny ruch czyta się jak błąd.
    */
    transform-origin: top;
  }

  .who__note {
    /* Cztery wiersze w makiecie — dlatego kolumna jest węższa niż jej miejsce
       w siatce. Wartość jest w `ch`, więc łamanie nie zależy od rozmiaru okna. */
    max-width: 34ch;
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* ── Kafle ──────────────────────────────────────────────────────────────── */

  .card {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-block);
    background-color: var(--color-surface-card);
    box-shadow: var(--shadow-card);
    /*
      PUŁAPKA (PLAYBOOK P-057): kafel niesie klasę `.reveal`, a ta wypełnia
      `transform` i `opacity` do końca życia strony (`animation-fill-mode:
      both`). Wypełnienie animacji BIJE każdą zwykłą deklarację, więc podniesienie
      kafla przez `translate` albo `scale` po prostu nic by nie zrobiło — i to
      cicho, bez błędu. Stąd hover kafla gra wyłącznie tym, czego animacja
      wejścia nie dotyka: tłem, obrysem i cieniem. Ruch dostają DZIECI kafla,
      które własnej animacji nie mają.
    */
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .card:hover {
    border-color: var(--color-border-card-hover);
    background-color: var(--color-surface-card-hover);
    box-shadow: var(--shadow-card-hover);
  }

  .card--person {
    padding: var(--space-2);
    gap: var(--space-2);
  }

  .card__media {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-media);
    /* Kadr jest kwadratem z makiety — zdjęcie dopasowuje się do niego. */
    aspect-ratio: 1;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
      Zbliżenie kadru, nie kafla: `.card__media` ma `overflow: hidden`, więc
      ramka stoi w miejscu i rusza się samo zdjęcie. `scale` osobną własnością,
      nie w `transform` — zdjęcie nie ma innych przekształceń, a osobna własność
      nie kasuje niczego, co ktoś dopisze obok.
    */
    transition: scale var(--duration-slow) var(--ease-standard);
  }

  .card--person:hover .card__media :global(img) {
    scale: var(--card-media-zoom);
  }

  .card__badge {
    position: absolute;
    inset-block-end: var(--space-2);
    inset-inline-start: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-full);
    background-color: var(--color-brand-glow);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    line-height: var(--leading-normal);
    text-transform: uppercase;
  }

  .card__badge-dot {
    width: var(--space-1);
    height: var(--space-1);
    border-radius: var(--radius-full);
    background-color: var(--color-fg);
  }

  .card__name {
    padding-inline: var(--space-1);
    padding-block-end: var(--space-1);
    color: var(--color-fg);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-normal);
  }

  .card--stat {
    position: relative;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--color-surface-stat);
  }

  .card--stat:hover {
    background-color: var(--color-surface-stat-hover);
  }

  /*
    Poświata pod kursorem. Pseudoelement, nie druga warstwa tła: przejście
    działa na `opacity`, czyli na kompozytorze (AGENT-RULES §6), a gradientu
    w `background-image` nie da się przenikać.
  */
  .card--stat::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: var(--gradient-card-glow);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .card--stat:hover::before {
    opacity: 1;
  }

  /*
    PUŁAPKA (ta sama co przy kaflach w CaseStudies): poświata jest
    `position: absolute`, więc maluje się NAD treścią w normalnym przepływie.
    Nadanie dzieciom `position: relative` wciąga je do tej samej warstwy, gdzie
    o kolejności decyduje pozycja w drzewie — a tam są po pseudoelemencie.
  */
  .card--stat > * {
    position: relative;
  }

  .card__icon {
    /* Ikona zostaje u góry, liczba spada na dół kafla. */
    margin-block-end: auto;
    color: var(--color-icon-muted);
    transition: color var(--duration-base) var(--ease-standard);
  }

  /* Pod kursorem ikona zapala się czerwienią — jedyny akcent koloru w kaflu. */
  .card--stat:hover .card__icon {
    color: var(--color-brand-glow);
  }

  .card__value {
    margin: var(--space-6) 0 0;
    color: var(--color-fg);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .card__description {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-normal);
  }

  /* ── Breakpointy ────────────────────────────────────────────────────────── */

  @media (min-width: 768px) {
    .who__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .who__text {
      font-size: var(--text-3xl);
    }
  }

  @media (min-width: 1024px) {
    /*
      Sześć kolumn na całą szerokość treści. Tekst bierze pięć lewych, kafle
      trzy prawe — dlatego kolumna 4, 5 i 6 pokrywa się z kolumnami kafli
      w każdym wierszu, a kafel 5 wiersza trzeciego stoi dokładnie pod kaflem
      środkowym wiersza drugiego (tak jak w makiecie).
    */
    .who__grid {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      grid-template-rows: auto auto auto;
      row-gap: var(--space-5);
    }

    .who__intro {
      grid-column: 1 / 6;
      grid-row: 1;
      margin-block-end: 0;
    }

    .who__aside {
      grid-column: 1 / 4;
      grid-row: 2 / 4;
      order: 0;
      margin-block-start: 0;
      /* Rozciągnięty na dwa wiersze, treść przy dole — kreska bierze resztę. */
      align-self: stretch;
    }

    .who__rail {
      display: block;
      position: relative;
      flex: 1;
      min-height: var(--space-8);
      width: 1px;
      overflow: hidden;
      background-color: var(--color-border-hairline);
      /* Cień z makiety: kreska ma odbijać się od tła, nie świecić. */
      filter: drop-shadow(0.5px 0 0 #000);
      /* Jednostki `cqh` w animacji światła odnoszą się do TEJ wysokości. */
      container-type: size;
    }

    .who__rail-light {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      width: 1px;
      height: 77px;
      background: linear-gradient(
        to bottom,
        rgb(255 0 85 / 0) 0%,
        var(--color-brand-glow) 47.6%,
        rgb(255 0 85 / 0) 100%
      );
      /* Tylko `translate` — bez layoutu i bez malowania (AGENT-RULES §6). */
      animation: who-rail-light 4s var(--ease-in-out-token) infinite;
    }

    /*
      Kafle siadają na pozycjach z makiety. Slot jest klasą liczoną z indeksu,
      nie selektorem `nth-of-type` — ten liczy osobno `<figure>` (osoba)
      i `<div>` (statystyka), więc mieszana kolejność rozjeżdżałaby siatkę.
    */
    .card--slot-1 {
      grid-column: 6;
      grid-row: 1;
      align-self: end;
    }

    .card--slot-2 {
      grid-column: 4;
      grid-row: 2;
    }

    .card--slot-3 {
      grid-column: 5;
      grid-row: 2;
    }

    .card--slot-4 {
      grid-column: 6;
      grid-row: 2;
    }

    .card--slot-5 {
      grid-column: 5;
      grid-row: 3;
    }
  }

  @keyframes who-rail-light {
    from {
      translate: 0 -77px;
    }
    to {
      translate: 0 100cqh;
    }
  }

  /*
   * Globalna reguła z global.css skraca czasy do 0,01 ms, ale oś scrolla nie ma
   * czasu trwania — dlatego odsłanianie wyłączamy wprost, zostawiając tekst
   * w stanie końcowym (jasnym), a nie początkowym.
   */
  @media (prefers-reduced-motion: reduce) {
    /*
      Reguła globalna skraca przejścia do 0,01 ms, ale zbliżenie kadru zostałoby
      wtedy PRZESKOKIEM — a to nadal ruch. Zmiany koloru i cienia zostają:
      niosą informację „kafel reaguje", nie ruch.
    */
    .card--person:hover .card__media :global(img) {
      scale: 1;
    }

    .who__word-bright {
      opacity: 1;
      animation: none;
    }

    .who__rail-light {
      animation: none;
      opacity: 0.6;
      translate: 0 calc(50cqh - 38px);
    }
  }
</style>
