---
import type { OurImpactBlock } from '@repo/shared'
import Picture from '@/components/ui/Picture.astro'
import { resolveVector } from '@/lib/media'

interface Props {
  block: OurImpactBlock
}

const { block } = Astro.props
const headingId = 'our-impact-heading'
const dashboardSrc = resolveVector(block.dashboard)
---

{/*
  Wejście sekcji. Grupa trzyma wszystkie animacje w środku na pierwszej klatce,
  dopóki obserwator w BaseLayout nie uzna, że warto ją odegrać — mechanizm jest
  opisany przy „W polu widzenia" w global.css.
*/}
<section class="impact" aria-labelledby={headingId} data-reveal-group>
  {/*
    Łuna. Kadr jest czarnym prostokątem z czerwoną plamą w środku — wtapia się
    przez maskę, która wycina samą plamę (uzasadnienie w spec.md).
  */}
  <div class="impact__glow reveal-fade" style="--reveal-index: 0" aria-hidden="true">
    <Picture
      image={block.glow}
      widths={[768, 1440, 1512]}
      sizes="(min-width: 768px) min(105vw, 1512px), 160vw"
    />
  </div>

  <div class="container-page impact__content">
    <p class="impact__eyebrow reveal" style="--reveal-index: 1">{block.eyebrow}</p>

    {/* Etykieta wyżej jest podpisem, nagłówkiem sekcji jest to zdanie. */}
    <h2 id={headingId} class="impact__heading reveal" style="--reveal-index: 2">{block.heading}</h2>

    {/*
      `src` ustawiamy dopiero przy wejściu sekcji w kadr, więc cała choreografia
      startuje przed użytkownikiem. Obraz w `noscript` jest bezpiecznym
      fallbackiem bez JS.

      Osobny dokument (a nie `<img>`) jest tu dziś wyłącznie po to, żeby strona
      mogła zatrzymać animacje panelu poza kadrem. Hovery, dla których ten iframe
      powstał, są wyłączone — patrz PLAYBOOK P-067.

      PUŁAPKA: panel NIE dostaje `scroll-settle` ani żadnej innej skalującej
      transformacji. Skala nad `<iframe>` każe przeglądarce rasterować zagnieżdżony
      dokument od nowa przy każdej wartości skali, a ten dokument ma 0,5 MB
      ścieżek i własne animacje — stąd zacinanie przy przejeździe przez sekcję
      i dryf pojedynczych grup SVG (ikona Google Ads w `3-box-row`). Wejście
      panelu odgrywa sam dokument (`panel-open`), więc nie ma czego dublować.
    */}
    <div class="impact__screen" data-impact-dashboard>
      <iframe
        class="impact__dashboard"
        data-src={dashboardSrc}
        title={block.dashboard.alt}
        tabindex="-1"
        width={block.dashboard.width}
        height={block.dashboard.height}
        loading="lazy"
      ></iframe>
      <noscript>
        <img
          src={dashboardSrc}
          alt={block.dashboard.alt}
          width={block.dashboard.width}
          height={block.dashboard.height}
          loading="lazy"
          decoding="async"
          fetchpriority="auto"
          draggable="false"
        />
      </noscript>
    </div>
  </div>
</section>

<script>
  const dashboard = document.querySelector<HTMLElement>('[data-impact-dashboard]')
  const frame = dashboard?.querySelector<HTMLIFrameElement>('[data-src]')

  if (dashboard && frame) {
    window.addEventListener('message', (event) => {
      if (event.source !== frame.contentWindow || event.data?.type !== 'adstic-dashboard:wheel') return

      const deltaX = Number(event.data.deltaX)
      const deltaY = Number(event.data.deltaY)
      if (!Number.isFinite(deltaX) || !Number.isFinite(deltaY)) return

      // Nad iframe kółko nie dociera do Lenis, więc deltę oddajemy jemu, a nie
      // natywnemu `scrollBy` — inaczej dwa źródła prawdy szarpią się o pozycję.
      const scroll = window.adsticScrollByWheel
      if (scroll) scroll(deltaX, deltaY)
      else window.scrollBy(deltaX, deltaY)
    })

    const load = () => {
      if (!frame.src) frame.src = frame.dataset.src ?? ''
    }

    /*
      Poza kadrem dokument SVG jest zatrzymywany. Jego pętle „oddychania"
      wykresów to transformacje SVG, których Chrome nie kompozytuje — każda
      klatka przemalowuje CAŁY dokument panelu. Płacimy za to tylko wtedy, gdy
      panel jest widoczny.
    */
    const setPaused = (paused: boolean) => {
      // Klasa, nie `style.animationPlayState`: ta własność się nie dziedziczy,
      // więc zatrzymanie potomków musi wyjść z reguły wewnątrz dokumentu SVG.
      frame.contentDocument?.documentElement?.classList.toggle('is-paused', paused)
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry?.isIntersecting) load()
          setPaused(!entry?.isIntersecting)
        },
        { rootMargin: '20% 0px', threshold: 0.08 },
      )
      observer.observe(dashboard)
    } else {
      load()
    }
  }
</script>

<style>
  .impact {
    position: relative;
    /*
      Sekcja maluje własne tło, a `isolation` domyka grupę kompozycji: ujemny
      `z-index` łuny leży nad tym tłem tylko wewnątrz tej grupy. Bez izolacji
      łuna wypada do stackingu strony, czyli POD tło malowane przez sekcję.
    */
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-bg);
    padding-block: var(--section-padding-y);
  }

  .impact__glow {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    z-index: -1;
    width: var(--impact-glow-width-narrow);
    /* Procent w `translate` liczy się od WŁASNEJ wysokości — dzięki temu
       łuna trzyma się nagłówka, a nie górnej krawędzi sekcji. */
    translate: -50% var(--impact-glow-shift-narrow);
    /*
      Kadr JPG jest prostokątem czerni ciemniejszej niż tło strony (~#050505
      vs #0D0F0D), więc każda jego krawędź jest widocznym odcięciem. Maska
      wycina z pliku samą plamę i wygasza ją we wszystkie strony, zanim
      krawędź zdąży się pojawić — dlatego elipsa, nie gradient pionowy.
      Maska jest kształtem wygaszenia, nie wartością wizualną; nie ma dla niej
      tokenu tak samo jak nie ma go dla `object-fit`.
    */
    mask-image: radial-gradient(60% 42% at 50% 30%, #000 30%, rgb(0 0 0 / 0.35) 62%, transparent 100%);
    pointer-events: none;
  }

  /* PUŁAPKA (PLAYBOOK P-011): `<img>` z Picture.astro nie ma `data-astro-cid-*`
     tego bloku — selektor musi iść przez rodzica i `:global()`. */
  .impact__glow :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .impact__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .impact__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .impact__eyebrow::before {
    content: '';
    width: var(--space-1);
    height: var(--space-1);
    background-color: var(--color-brand);
  }

  .impact__heading {
    max-width: var(--impact-heading-width);
    margin: 0 0 var(--space-7);
    color: var(--color-fg);
    font-family: var(--font-heading);
    /* 48 px dotyczy desktopu — na 390 px zostawiałoby dwa słowa w wierszu. */
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-display);
    /* Dwa wiersze mają być podobnej długości — tak łamie się w makiecie. */
    text-wrap: balance;
  }

  .impact__screen {
    width: 100%;
    aspect-ratio: var(--impact-dashboard-ratio);
  }

  .impact__dashboard,
  .impact__screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .impact__dashboard {
    border: 0;
    height: 100%;
  }

  @media (min-width: 768px) {
    .impact__glow {
      width: var(--impact-glow-width);
      translate: -50% var(--impact-glow-shift);
    }

    .impact__heading {
      font-size: var(--text-4xl);
    }
  }
</style>
